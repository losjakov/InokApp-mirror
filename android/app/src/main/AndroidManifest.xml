<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- R-9 / privacy policy: Analytics must never collect the advertising ID (effective once Firebase arrives, stage 3) -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <!-- A-36: collection starts OFF; the app turns it on only after reading «Режим інкогніто» = off (A-96 W-7, AnalyticsPlugin) -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- screens are named by the app (the route, not the one Capacitor activity) -->
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        <!-- A-92: the site this app belongs to (res/values/asset_statements.xml) - the site's getInstalledRelatedApps() sees the app -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- cloud_41 (A-133 C1): the four quick actions on the icon (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <!-- A-76 App Links (+ A-138: the LIST pages and /dioceses/ too): an inok.info ARTICLE, MONASTERY or EPARCHY link opens here (the site's /.well-known/assetlinks.json, R-7); the ONE
                 router (src/data/links/router.ts) opens an article / a card and sends any other path these prefixes let in to the browser -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="inok.info" />
                <data android:pathPrefix="/articles/publications/" />
                <data android:pathPrefix="/articles/video/" />
                <data android:pathPrefix="/articles/news/" />
                <data android:pathPrefix="/monasteries/" />
                <data android:pathPrefix="/dioceses/" />
                <data android:pathPrefix="/live/" />
                <!-- T4 (cloud_43): the site's «Публікації» umbrella - the EXACT path (other /articles/... stay in the browser) -->
                <data android:path="/articles/" />
                <!-- A-166 (cloud_44): the site's SHORT card / gallery links /<id>, /<id>/g, /<uk|ru|en>/<id>[/g] (digits only, Android 12+ = API 31:
                     pathAdvancedPattern; an older Android ignores it - the alias below) and the legacy /objects/monasteries/<id>/ -->
                <data android:pathPrefix="/objects/monasteries/" />
                <data android:pathAdvancedPattern="/[0-9]+" />
                <data android:pathAdvancedPattern="/[0-9]+/" />
                <data android:pathAdvancedPattern="/[0-9]+/[gG]" />
                <data android:pathAdvancedPattern="/[0-9]+/[gG]/" />
                <data android:pathAdvancedPattern="/uk/[0-9]+" />
                <data android:pathAdvancedPattern="/uk/[0-9]+/" />
                <data android:pathAdvancedPattern="/uk/[0-9]+/[gG]" />
                <data android:pathAdvancedPattern="/uk/[0-9]+/[gG]/" />
                <data android:pathAdvancedPattern="/ru/[0-9]+" />
                <data android:pathAdvancedPattern="/ru/[0-9]+/" />
                <data android:pathAdvancedPattern="/ru/[0-9]+/[gG]" />
                <data android:pathAdvancedPattern="/ru/[0-9]+/[gG]/" />
                <data android:pathAdvancedPattern="/en/[0-9]+" />
                <data android:pathAdvancedPattern="/en/[0-9]+/" />
                <data android:pathAdvancedPattern="/en/[0-9]+/[gG]" />
                <data android:pathAdvancedPattern="/en/[0-9]+/[gG]/" />
            </intent-filter>

        </activity>

        <!-- A-166 (cloud_44): the SAME short links on Android 8-11 (API 26-30), which has no pathAdvancedPattern: pathPattern cannot say «digits only»,
             so «/<digit>…» is let in and the ONE router hands anything that is not a card to the browser. ENABLED ONLY BELOW API 31
             (res/values-v31/bools.xml), so Android 12+ keeps the digits-only filter above. -->
        <activity-alias
            android:name=".ShortLinks"
            android:targetActivity=".MainActivity"
            android:enabled="@bool/inok_short_links_legacy"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="inok.info" />
                <data android:pathPattern="/0.*" />
                <data android:pathPattern="/1.*" />
                <data android:pathPattern="/2.*" />
                <data android:pathPattern="/3.*" />
                <data android:pathPattern="/4.*" />
                <data android:pathPattern="/5.*" />
                <data android:pathPattern="/6.*" />
                <data android:pathPattern="/7.*" />
                <data android:pathPattern="/8.*" />
                <data android:pathPattern="/9.*" />
                <data android:pathPattern="/uk/0.*" />
                <data android:pathPattern="/uk/1.*" />
                <data android:pathPattern="/uk/2.*" />
                <data android:pathPattern="/uk/3.*" />
                <data android:pathPattern="/uk/4.*" />
                <data android:pathPattern="/uk/5.*" />
                <data android:pathPattern="/uk/6.*" />
                <data android:pathPattern="/uk/7.*" />
                <data android:pathPattern="/uk/8.*" />
                <data android:pathPattern="/uk/9.*" />
                <data android:pathPattern="/ru/0.*" />
                <data android:pathPattern="/ru/1.*" />
                <data android:pathPattern="/ru/2.*" />
                <data android:pathPattern="/ru/3.*" />
                <data android:pathPattern="/ru/4.*" />
                <data android:pathPattern="/ru/5.*" />
                <data android:pathPattern="/ru/6.*" />
                <data android:pathPattern="/ru/7.*" />
                <data android:pathPattern="/ru/8.*" />
                <data android:pathPattern="/ru/9.*" />
                <data android:pathPattern="/en/0.*" />
                <data android:pathPattern="/en/1.*" />
                <data android:pathPattern="/en/2.*" />
                <data android:pathPattern="/en/3.*" />
                <data android:pathPattern="/en/4.*" />
                <data android:pathPattern="/en/5.*" />
                <data android:pathPattern="/en/6.*" />
                <data android:pathPattern="/en/7.*" />
                <data android:pathPattern="/en/8.*" />
                <data android:pathPattern="/en/9.*" />
            </intent-filter>
        </activity-alias>

        <!-- 1.0.18 (A-160): the language changed / the app updated -> the widget picker's generated previews (Android 15+) + the widgets redrawn -->
        <receiver android:name=".WidgetLocaleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- T9 (cloud_43, A-153 (2)): the three home-screen widgets (WidgetRender / WidgetStore / WidgetWorker) -->
        <receiver android:name=".LiveWidget" android:exported="false" android:label="@string/widget_live">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_live_info" />
        </receiver>
        <receiver android:name=".UpcomingWidget" android:exported="false" android:label="@string/widget_upcoming">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_upcoming_info" />
        </receiver>
        <receiver android:name=".NewWidget" android:exported="false" android:label="@string/widget_new">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_new_info" />
        </receiver>

        <!-- stage 3 push: data messages become notifications in the app's language; priority 1 wins over the plugin's service -->
        <service android:name=".InokMessagingService" android:exported="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_push" />
        <!-- A-84: the old one channel `inok_push` is deleted by Notifier (1.0.5); FCM's own (non-data) messages would go to «Нові статті» -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="inok_articles" />
        <!-- A-84 (g): «Позначити прочитаним» and a swiped article (the summary follows) - only our own PendingIntents reach it -->
        <receiver android:name=".NotifyReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- A-76: MainActivity hands a Custom Tab of its own back to the phone's browser - it must see the browsers (Android 11+ package visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- «near me» radius and distance sort (spec §3); asked at runtime, only when the user turns the filter on -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- R-9: no advertising ID, whatever a library asks for (proven by the merged manifest in CI, build.yml) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- A-36: firebase-analytics also asks for the Privacy Sandbox ad id / attribution / topics — removed (build.yml R-9 greps AD_ID) -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
    <!-- N5 (REVIEW cloud_21): androidx.biometric of @capacitor-community/sqlite asks these; the app never sets biometricAuth (capacitor.config.ts) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <!-- T8 (A-153 (1), cloud_43): @capacitor/local-notifications declares SCHEDULE_EXACT_ALARM; «Нагадати» is INEXACT (isExactNotification false,
         allowWhileIdle) - the owner's «без лишних разрешений»: no exact-alarm permission in the merged manifest (build.yml greps it) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <!-- T9 (cloud_43): androidx.work declares FOREGROUND_SERVICE for its SystemForegroundService; WidgetWorker never runs in the foreground
         (no setForeground) - the owner's «без лишних разрешений»: removed (build 44907976662 listed it) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
</manifest>
