<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.18 (A-163, reference/wrow_*): the 2x1 look (half the width) - live: the header + the pictures of up to 3 channels; upcoming: «НАЙБЛИЖЧА»,
     the day and time (shrinks to stay whole) and the channel's picture; new: the dot + the newest title (shrinks to stay whole) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_dot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="8dp" android:visibility="gone" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/w_head_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/w_live_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_accent"
                android:textSize="13sp" android:textStyle="bold" android:textAllCaps="true" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_big" android:layout_width="match_parent" android:layout_height="30dp" android:textColor="@color/widget_text" android:textStyle="bold" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:visibility="gone" />
        <TextView android:id="@+id/w_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold"
            android:maxLines="3" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:hyphenationFrequency="none" android:breakStrategy="simple" android:includeFontPadding="true" android:lineSpacingMultiplier="1.07" android:visibility="gone" />
    <TextView android:id="@+id/w_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted"
        android:textSize="12sp" android:visibility="gone" android:paddingTop="4dp" />
        <FrameLayout android:id="@+id/w_avatars" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginTop="4dp" android:visibility="gone">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="0dp">
            <ImageView android:id="@+id/w_av1" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_av_ring" android:padding="1dp" android:visibility="gone" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="26dp">
            <ImageView android:id="@+id/w_av2" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_av_ring" android:padding="1dp" android:visibility="gone" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="52dp">
            <ImageView android:id="@+id/w_av3" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/widget_av_ring" android:padding="1dp" android:visibility="gone" android:importantForAccessibility="no" />
        </FrameLayout>
        </FrameLayout>
    </LinearLayout>
    <ImageView android:id="@+id/w_side" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:background="@drawable/widget_av_ring" android:padding="1dp" android:visibility="gone" android:importantForAccessibility="no" />
</LinearLayout>
