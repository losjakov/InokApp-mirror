<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.18 (A-163, the CD kit): the 4x2 / 4x4 look - the header («оновлено HH:MM» at its end), the rows that fit WHOLE (WidgetModel.fit;
     rows added by WidgetRender from widget_row_<kind>.xml), the foot only for «+N ще». The numbers here = WidgetModel's (WidgetModelTest pins them) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="8dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginBottom="2dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="6dp" android:src="@mipmap/ic_launcher_round" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/w_live_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot" android:visibility="gone" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_header" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_accent"
            android:textSize="13sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.04" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/w_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted"
        android:textSize="12sp" android:visibility="gone" android:paddingTop="4dp" />
    <TextView android:id="@+id/w_foot" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center_vertical" android:textColor="@color/widget_muted" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
