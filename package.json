{
  "name": "inokapp",
  "private": true,
  "version": "1.0.14",
  "description": "Монастирський вісник України — official mobile app of inok.info (info.inok.app)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "screens": "playwright test -c screens/playwright.config.ts",
    "fixtures:validate": "python3 scripts/validate_fixtures.py"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-app-update": "^8.1.1",
    "@ionic/react": "^9.0.10",
    "@ionic/react-router": "^9.0.10",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "ionicons": "^8.1.0",
    "maplibre-gl": "^6.16.0",
    "pako": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 89",
    "ios_saf >= 15"
  ]
}
